# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Local run receipts (regenerate via scripts/verify_load.py)
logs/

# Local run outputs (regenerate via scripts/run_artifact.py)
artifacts/

# Create job outputs (served from disk by /api/create; runtime state)
jobs/

# SAE weights and fires caches (regenerate via scripts/train_sae.py;
# per-layer config.json files stay committed)
store/sae/**/*.safetensors
store/sae/**/fires.npz
store/sae/**/tokens.json

# Logs
*.log

# macOS
.DS_Store

# local debug and calibration dumps
calib-*.json
.claude/launch.json
